# version: '3.8'

networks:
  template-net:
    driver: bridge

services:
  template-django:
    build:
      context: ../
      dockerfile: DockerFile
    container_name: template-django
    restart: unless-stopped
    mem_limit: 512m
    cpus: "0.75"
    env_file:
      - ../.env
    environment:
      - DJANGO_ENV=${DJANGO_ENV:-prod}
    volumes:
      - ../:/app
      - ../staticfiles:/app/staticfiles
      # - sqlite_data:/app/data
    # ports:
    #   - "127.0.0.1:${PORT:-8000}:${PORT:-80}"
    command: >
      sh -c "python manage.py migrate &&
             python manage.py collectstatic --noinput &&
             gunicorn config.wsgi:application --bind 0.0.0.0:$${PORT:-80} --workers=3"
    networks:
      - template-net

  nginx:
    image: nginx:alpine
    container_name: nginx-proxy
    ports:
      - "8151:80"
    volumes:
      - ../staticfiles:/app/staticfiles:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - template-django
    networks:
      - template-net